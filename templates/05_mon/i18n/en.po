msgid "gluon-config-mode:welcome"
msgstr ""
"<p>Set up your Freifunk node for DOMAINNAME here.</p>"
"<p>This firmware is for nodes DOMAINREGIONEN. Elsewhere: "
"<a href=\"https://freifunk.net/en/how-to-join/find-your-nearest-community/\" target=\"_blank\">find your community</a>. "
"We may block nodes without valid contact details.</p>"

msgid "gluon-config-mode:pubkey"
msgstr "<p>Your node is rebooting and will then connect to Freifunk.</p>"

msgid "gluon-config-mode:novpn"
msgstr ""
"<p><div class=\"the-key\">Without mesh VPN your node only reaches the "
"internet through neighbouring nodes in radio range.</div>"
"It is rebooting now.</p>"

msgid "gluon-config-mode:reboot"
msgstr ""
"<p>Your node is rebooting, this page will be gone. To come back: press the "
"reset button for about 10 seconds while it runs.</p>"
"<p>In about 20 minutes it appears as <em><%= pcdata(hostname) %></em> on "
"the <a href=\"https://MAPWEBSITE/#!v:g\" target=\"_blank\">map</a>. "
"More about METANAME <a href=\"https://METAWEBSITE\" target=\"_blank\">on our website</a>.</p>"

msgid "gluon-config-mode:altitude-label"
msgstr "Height (3 m per floor)"

msgid "gluon-config-mode:altitude-help"
msgstr "Optional, above ground."

msgid "gluon-config-mode:contact-note"
msgstr "E-mail address"

msgid "gluon-config-mode:contact-help"
msgstr ""
"An e-mail address to reach you, required by the Pico Peering Agreement. It "
"is <em>public</em> together with the coordinates and can be deleted here at "
"any time."

msgid "gluon-config-mode:geo-location-help"
msgstr ""
"With coordinates your node appears on the "
"<a href=\"https://MAPWEBSITE/#!v:g\" target=\"_blank\">map</a>."
