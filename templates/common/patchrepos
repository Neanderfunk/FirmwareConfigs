# Patch-Repos, die prepare.sh neben dem Gluon-Baum unter patch-repos/<name>
# am gepinnten Commit bereitstellt und deren apply.sh es aufruft.
#
# Aufbau wie Gluons modules: je Repo REPO, BRANCH und COMMIT. Der Commit muss
# auf dem Branch liegen. Die Reihenfolge in PATCHREPOS ist die
# Anwendungsreihenfolge, in beiden Phasen; danach folgen die Patches aus
# patches/ in diesem Repo.
#
# Eine Aenderung hier (neuer Commit) aendert den Fingerabdruck des golden
# tree, der naechste Lauf baut ihn also neu.

PATCHREPOS="hardware fixes"

PATCHREPO_HARDWARE_REPO=https://github.com/Neanderfunk/gluon-patches-hardware.git
PATCHREPO_HARDWARE_BRANCH=v2023.2.x
PATCHREPO_HARDWARE_COMMIT=845a95f09282cd0a9d5349b691448d58039a4e94

PATCHREPO_FIXES_REPO=https://github.com/Neanderfunk/gluon-patches-fixes.git
PATCHREPO_FIXES_BRANCH=v2023.2.x
PATCHREPO_FIXES_COMMIT=0b05233d0d6a69f424c20ae5c25c80f47ca029ed
